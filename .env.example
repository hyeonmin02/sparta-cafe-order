# ================================================================
# .env.example — 환경변수 템플릿
# 이 파일을 복사해서 .env 로 만들고 실제 값으로 채워주세요
# cp .env.example .env
# ================================================================

# Database Settings
DB_URL=jdbc:mysql://mysql:3306/sparta_cafe?useSSL=false&serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=your_db_password

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka Settings
KAFKA_SERVERS=kafka:9092

# JWT Settings
# HS256 을 위해 최소 32바이트 이상의 랜덤 문자열 필수
JWT_SECRET_KEY=your_very_long_and_secure_random_secret_key_at_least_32_bytes

# Docker 컨테이너 설정 (docker-compose 가 사용하는 변수)
MYSQL_DATABASE=sparta_cafe
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_EXTERNAL_PORT=3307
REDIS_EXTERNAL_PORT=6379
APP_EXTERNAL_PORT=8080